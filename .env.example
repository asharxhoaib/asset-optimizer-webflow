WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WEBFLOW_REDIRECT_URI=http://localhost:3000/oauth/callback
# cms:write and pages:read are optional extras needed only for re-pointing CMS references / scanning page DOMs
WEBFLOW_SCOPES=assets:read,assets:write,sites:read,cms:read

# Public base URL Webflow can reach (use your ngrok https URL during local dev)
APP_PUBLIC_URL=http://localhost:3000

# Passphrase used to derive the AES-256-GCM key that encrypts stored OAuth tokens
TOKEN_ENCRYPTION_KEY=change-me-in-production

# Alt-text suggestions: "mock" (deterministic, offline) or "http"
ALT_TEXT_PROVIDER=mock
ALT_TEXT_HTTP_URL=
ALT_TEXT_HTTP_KEY=

# Image encoder: leave ENCODER_HTTP_URL empty to use the passthrough encoder (no savings, pipeline still runs)
ENCODER_HTTP_URL=
ENCODER_HTTP_KEY=

# Safety cap for downloaded assets, in megabytes
MAX_DOWNLOAD_MB=50

DATABASE_PATH=./db/assets.sqlite
PORT=3000
